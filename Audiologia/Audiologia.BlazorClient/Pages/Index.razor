@page "/"
@inject HttpClient Http
@using Audiologia.BlazorClient.Models

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard
        </h2>
        <p class="text-muted">Welcome to the Audiology Center Management System</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-primary bg-opacity-10">
                    <i class="bi bi-people text-primary"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@totalPatients</div>
                    <div class="text-muted small">Registered Patients</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-success bg-opacity-10">
                    <i class="bi bi-person-badge text-success"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@totalSpecialists</div>
                    <div class="text-muted small">Active Specialists</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-warning bg-opacity-10">
                    <i class="bi bi-calendar-check text-warning"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@totalAppointments</div>
                    <div class="text-muted small">Total Appointments</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="icon-box bg-info bg-opacity-10">
                    <i class="bi bi-clipboard2-pulse text-info"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@totalTests</div>
                    <div class="text-muted small">Hearing Tests Done</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-clock-history me-2 text-primary"></i>Latest Appointments
                </h5>
            </div>
            <div class="card-body p-0">
                @if (appointments is null)
                {
                    <div class="p-4 text-center">
                        <div class="spinner-border text-primary spinner-border-sm"></div>
                        <span class="ms-2 text-muted">Loading...</span>
                    </div>
                }
                else if (!appointments.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-calendar-x fs-1"></i>
                        <p class="mt-2">No appointments registered</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date & Time</th>
                                    <th>Patient</th>
                                    <th>Specialist</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in appointments.Take(8))
                                {
                                    <tr>
                                        <td>@a.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@a.PatientName</td>
                                        <td>@a.SpecialistName</td>
                                        <td><span class="badge bg-secondary">@a.AppointmentType</span></td>
                                        <td>
                                            <span class="badge badge-@a.Status.ToLower()">@a.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private int totalPatients;
    private int totalSpecialists;
    private int totalAppointments;
    private int totalTests;
    private List<AppointmentModel>? appointments;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var patients = await Http.GetFromJsonAsync<List<PatientModel>>("api/patients");
            var specialists = await Http.GetFromJsonAsync<List<SpecialistModel>>("api/specialists/active");
            appointments = await Http.GetFromJsonAsync<List<AppointmentModel>>("api/appointments");
            var tests = await Http.GetFromJsonAsync<List<HearingTestModel>>("api/hearingtests");

            totalPatients = patients?.Count ?? 0;
            totalSpecialists = specialists?.Count ?? 0;
            totalAppointments = appointments?.Count ?? 0;
            totalTests = tests?.Count ?? 0;
        }
        catch { }
    }
}