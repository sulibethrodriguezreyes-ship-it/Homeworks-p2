@page "/patients"
@inject HttpClient Http
@using Audiologia.BlazorClient.Models

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-people text-primary me-2"></i>Patients
        </h2>
        <p class="text-muted mb-0">Manage patients</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateForm">
        <i class="bi bi-plus-lg me-1"></i> New Patient
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-@messageType alert-dismissible fade show">
        @message
        <button type="button" class="btn-close" @onclick="ClearMessage"></button>
    </div>
}

@if (showForm)
{
    <div class="card form-card mb-4">
        <h5 class="fw-bold mb-3">
            @(editingId.HasValue ? "Edit Patient" : "New Patient")
        </h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">First Name *</label>
                <input class="form-control" @bind="form.FirstName" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Last Name *</label>
                <input class="form-control" @bind="form.LastName" />
            </div>

            <div class="col-md-4">
                <label class="form-label">ID Number *</label>
                <input class="form-control" @bind="form.IdNumber" disabled="@editingId.HasValue" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Date of Birth *</label>
                <input type="date" class="form-control" @bind="form.DateOfBirth" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Phone</label>
                <input class="form-control" @bind="form.Phone" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="form.Email" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Address</label>
                <input class="form-control" @bind="form.Address" />
            </div>

            <div class="col-12">
                <label class="form-label">Medical History</label>
                <textarea class="form-control" rows="3" @bind="form.MedicalHistory"></textarea>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@saving">
                @(editingId.HasValue ? "Update" : "Save")
            </button>
            <button class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
        </div>
    </div>
}

<div class="table-container">
    @if (patients is null)
    {
        <div class="p-4 text-center">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (!patients.Any())
    {
        <div class="p-4 text-center text-muted">
            No patients registered
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>ID Number</th>
                        <th>Age</th>
                        <th>Phone</th>
                        <th>Appointments</th>
                        <th>Tests</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in patients)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@p.FullName</div>
                                <small class="text-muted">@p.Email</small>
                            </td>
                            <td>@p.IdNumber</td>
                            <td>@p.Age</td>
                            <td>@p.Phone</td>
                            <td>@p.TotalAppointments</td>
                            <td>@p.TotalHearingTests</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditPatient(p)">
                                    Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePatientAsync(p.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<PatientModel>? patients;
    private PatientCreateModel form = new();
    private bool showForm;
    private bool saving;
    private int? editingId;
    private string message = string.Empty;
    private string messageType = "success";

    protected override async Task OnInitializedAsync()
    {
        await LoadPatientsAsync();
    }

    private async Task LoadPatientsAsync()
    {
        patients = await Http.GetFromJsonAsync<List<PatientModel>>("api/patients");
    }

    private void OpenCreateForm()
    {
        form = new PatientCreateModel();
        editingId = null;
        showForm = true;
    }

    private void EditPatient(PatientModel patient)
    {
        editingId = patient.Id;
        form = new PatientCreateModel
        {
            FirstName = patient.FirstName,
            LastName = patient.LastName,
            IdNumber = patient.IdNumber,
            DateOfBirth = patient.DateOfBirth,
            Phone = patient.Phone,
            Email = patient.Email,
            Address = patient.Address,
            MedicalHistory = patient.MedicalHistory
        };
        showForm = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.FirstName) ||
            string.IsNullOrWhiteSpace(form.LastName) ||
            string.IsNullOrWhiteSpace(form.IdNumber))
        {
            ShowMessage("First name, last name and ID number are required.", "danger");
            return;
        }

        saving = true;

        try
        {
            HttpResponseMessage response;

            if (editingId.HasValue)
            {
                var updateDto = new
                {
                    form.FirstName,
                    form.LastName,
                    form.Phone,
                    form.Email,
                    form.Address,
                    form.MedicalHistory
                };

                response = await Http.PutAsJsonAsync($"api/patients/{editingId.Value}", updateDto);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/patients", form);
            }

            if (response.IsSuccessStatusCode)
            {
                ShowMessage(editingId.HasValue ? "Patient updated successfully." : "Patient created successfully.", "success");
                CancelForm();
                await LoadPatientsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage(error, "danger");
            }
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, "danger");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeletePatientAsync(int id)
    {
        var response = await Http.DeleteAsync($"api/patients/{id}");

        if (response.IsSuccessStatusCode)
        {
            ShowMessage("Patient deleted successfully.", "success");
            await LoadPatientsAsync();
        }
        else
        {
            ShowMessage("Could not delete patient.", "danger");
        }
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        form = new PatientCreateModel();
    }

    private void ShowMessage(string text, string type)
    {
        message = text;
        messageType = type;
    }

    private void ClearMessage()
    {
        message = string.Empty;
    }
}