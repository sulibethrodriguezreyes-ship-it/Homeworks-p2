@page "/specialists"
@inject HttpClient Http
@using Audiologia.BlazorClient.Models

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-person-badge text-success me-2"></i>Specialists
        </h2>
        <p class="text-muted mb-0">Manage the specialist team</p>
    </div>
    <button class="btn btn-success" @onclick="OpenCreateForm">
        <i class="bi bi-plus-lg me-1"></i> New Specialist
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-@messageType alert-dismissible fade show">
        @message
        <button type="button" class="btn-close" @onclick="ClearMessage"></button>
    </div>
}

@if (showForm)
{
    <div class="card form-card mb-4">
        <h5 class="fw-bold mb-3">
            @(editingId.HasValue ? "Edit Specialist" : "New Specialist")
        </h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">First Name *</label>
                <input class="form-control" @bind="form.FirstName" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Last Name *</label>
                <input class="form-control" @bind="form.LastName" />
            </div>

            <div class="col-md-4">
                <label class="form-label">License Number *</label>
                <input class="form-control" @bind="form.LicenseNumber" disabled="@editingId.HasValue" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Specialty</label>
                <input class="form-control" @bind="form.Specialty" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Phone</label>
                <input class="form-control" @bind="form.Phone" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="form.Email" />
            </div>

            @if (editingId.HasValue)
            {
                <div class="col-12">
                    <div class="form-check">
                        <input id="isActive" class="form-check-input" type="checkbox" @bind="isActive" />
                        <label class="form-check-label" for="isActive">Active specialist</label>
                    </div>
                </div>
            }
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-success" @onclick="SaveAsync" disabled="@saving">
                @(editingId.HasValue ? "Update" : "Save")
            </button>
            <button class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
        </div>
    </div>
}

<div class="table-container">
    @if (specialists is null)
    {
        <div class="p-4 text-center">
            <div class="spinner-border text-success"></div>
        </div>
    }
    else if (!specialists.Any())
    {
        <div class="p-4 text-center text-muted">
            No specialists registered
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>License</th>
                        <th>Specialty</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in specialists)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@s.FullName</div>
                                <small class="text-muted">@s.Email</small>
                            </td>
                            <td>@s.LicenseNumber</td>
                            <td>@s.Specialty</td>
                            <td>@s.Phone</td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditSpecialist(s)">
                                    Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSpecialistAsync(s.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<SpecialistModel>? specialists;
    private SpecialistCreateModel form = new();
    private bool showForm;
    private bool saving;
    private bool isActive = true;
    private int? editingId;
    private string message = string.Empty;
    private string messageType = "success";

    protected override async Task OnInitializedAsync()
    {
        await LoadSpecialistsAsync();
    }

    private async Task LoadSpecialistsAsync()
    {
        specialists = await Http.GetFromJsonAsync<List<SpecialistModel>>("api/specialists");
    }

    private void OpenCreateForm()
    {
        form = new SpecialistCreateModel();
        editingId = null;
        isActive = true;
        showForm = true;
    }

    private void EditSpecialist(SpecialistModel specialist)
    {
        editingId = specialist.Id;
        form = new SpecialistCreateModel
        {
            FirstName = specialist.FirstName,
            LastName = specialist.LastName,
            LicenseNumber = specialist.LicenseNumber,
            Specialty = specialist.Specialty,
            Phone = specialist.Phone,
            Email = specialist.Email
        };
        isActive = specialist.IsActive;
        showForm = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.FirstName) ||
            string.IsNullOrWhiteSpace(form.LastName) ||
            string.IsNullOrWhiteSpace(form.LicenseNumber))
        {
            ShowMessage("First name, last name and license number are required.", "danger");
            return;
        }

        saving = true;

        try
        {
            HttpResponseMessage response;

            if (editingId.HasValue)
            {
                var updateDto = new
                {
                    form.FirstName,
                    form.LastName,
                    form.Specialty,
                    form.Phone,
                    form.Email,
                    IsActive = isActive
                };

                response = await Http.PutAsJsonAsync($"api/specialists/{editingId.Value}", updateDto);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/specialists", form);
            }

            if (response.IsSuccessStatusCode)
            {
                ShowMessage(editingId.HasValue ? "Specialist updated successfully." : "Specialist created successfully.", "success");
                CancelForm();
                await LoadSpecialistsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage(error, "danger");
            }
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, "danger");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteSpecialistAsync(int id)
    {
        var response = await Http.DeleteAsync($"api/specialists/{id}");

        if (response.IsSuccessStatusCode)
        {
            ShowMessage("Specialist deleted successfully.", "success");
            await LoadSpecialistsAsync();
        }
        else
        {
            ShowMessage("Could not delete specialist.", "danger");
        }
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        form = new SpecialistCreateModel();
        isActive = true;
    }

    private void ShowMessage(string text, string type)
    {
        message = text;
        messageType = type;
    }

    private void ClearMessage()
    {
        message = string.Empty;
    }
}