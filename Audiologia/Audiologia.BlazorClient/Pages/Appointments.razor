@page "/appointments"
@inject HttpClient Http
@using Audiologia.BlazorClient.Models

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-calendar-check text-warning me-2"></i>Appointments
        </h2>
        <p class="text-muted mb-0">Manage appointments</p>
    </div>
    <button class="btn btn-warning text-dark" @onclick="OpenCreateForm">
        <i class="bi bi-plus-lg me-1"></i> New Appointment
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-@messageType alert-dismissible fade show">
        @message
        <button type="button" class="btn-close" @onclick="ClearMessage"></button>
    </div>
}

@if (showForm)
{
    <div class="card form-card mb-4">
        <h5 class="fw-bold mb-3">
            @(editingId.HasValue ? "Edit Appointment" : "New Appointment")
        </h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Patient *</label>
                <select class="form-select" @bind="form.PatientId" disabled="@editingId.HasValue">
                    <option value="0">-- Select patient --</option>
                    @foreach (var p in (patients ?? new List<PatientModel>()))
                    {
                        <option value="@p.Id">@p.FullName</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Specialist *</label>
                <select class="form-select" @bind="form.SpecialistId" disabled="@editingId.HasValue">
                    <option value="0">-- Select specialist --</option>
                    @foreach (var s in (specialists ?? new List<SpecialistModel>()))
                    {
                        <option value="@s.Id">@s.FullName</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Date and Time *</label>
                <input type="datetime-local" class="form-control" @bind="form.ScheduledAt" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Appointment Type</label>
                <input class="form-control" @bind="form.AppointmentType" />
            </div>

            <div class="col-md-8">
                <label class="form-label">Reason *</label>
                <input class="form-control" @bind="form.Reason" />
            </div>

            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea class="form-control" rows="3" @bind="form.Notes"></textarea>
            </div>

            @if (editingId.HasValue)
            {
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="selectedStatus">
                        <option value="0">Pending</option>
                        <option value="1">Confirmed</option>
                        <option value="2">Completed</option>
                        <option value="3">Cancelled</option>
                        <option value="4">NoShow</option>
                    </select>
                </div>
            }
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-warning text-dark" @onclick="SaveAsync" disabled="@saving">
                @(editingId.HasValue ? "Update" : "Save")
            </button>
            <button class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
        </div>
    </div>
}

<div class="table-container">
    @if (appointments is null)
    {
        <div class="p-4 text-center">
            <div class="spinner-border text-warning"></div>
        </div>
    }
    else if (!appointments.Any())
    {
        <div class="p-4 text-center text-muted">
            No appointments registered
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Patient</th>
                        <th>Specialist</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in appointments)
                    {
                        <tr>
                            <td>@a.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@a.PatientName</td>
                            <td>@a.SpecialistName</td>
                            <td>@a.AppointmentType</td>
                            <td>@a.Status</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditAppointment(a)">
                                    Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAppointmentAsync(a.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<AppointmentModel>? appointments;
    private List<PatientModel>? patients;
    private List<SpecialistModel>? specialists;

    private AppointmentCreateModel form = new();
    private bool showForm;
    private bool saving;
    private int? editingId;
    private int selectedStatus = 0;
    private string message = string.Empty;
    private string messageType = "success";

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        appointments = await Http.GetFromJsonAsync<List<AppointmentModel>>("api/appointments");
        patients = await Http.GetFromJsonAsync<List<PatientModel>>("api/patients");
        specialists = await Http.GetFromJsonAsync<List<SpecialistModel>>("api/specialists/active");
    }

    private void OpenCreateForm()
    {
        form = new AppointmentCreateModel
        {
            ScheduledAt = DateTime.Now.AddDays(1)
        };

        editingId = null;
        selectedStatus = 0;
        showForm = true;
    }

    private void EditAppointment(AppointmentModel appointment)
    {
        editingId = appointment.Id;
        form = new AppointmentCreateModel
        {
            ScheduledAt = appointment.ScheduledAt,
            Reason = appointment.Reason,
            AppointmentType = appointment.AppointmentType,
            Notes = appointment.Notes,
            PatientId = appointment.PatientId,
            SpecialistId = appointment.SpecialistId
        };

        selectedStatus = ParseStatus(appointment.Status);
        showForm = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.Reason) || form.PatientId == 0 || form.SpecialistId == 0)
        {
            ShowMessage("Patient, specialist and reason are required.", "danger");
            return;
        }

        saving = true;

        try
        {
            HttpResponseMessage response;

            if (editingId.HasValue)
            {
                var updateDto = new
                {
                    form.ScheduledAt,
                    form.Reason,
                    form.AppointmentType,
                    form.Notes,
                    Status = selectedStatus
                };

                response = await Http.PutAsJsonAsync($"api/appointments/{editingId.Value}", updateDto);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/appointments", form);
            }

            if (response.IsSuccessStatusCode)
            {
                ShowMessage(editingId.HasValue ? "Appointment updated successfully." : "Appointment created successfully.", "success");
                CancelForm();
                await LoadAllAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage(error, "danger");
            }
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, "danger");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAppointmentAsync(int id)
    {
        var response = await Http.DeleteAsync($"api/appointments/{id}");

        if (response.IsSuccessStatusCode)
        {
            ShowMessage("Appointment deleted successfully.", "success");
            await LoadAllAsync();
        }
        else
        {
            ShowMessage("Could not delete appointment.", "danger");
        }
    }

    private int ParseStatus(string status) => status switch
    {
        "Pending" => 0,
        "Confirmed" => 1,
        "Completed" => 2,
        "Cancelled" => 3,
        "NoShow" => 4,
        _ => 0
    };

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        selectedStatus = 0;
        form = new AppointmentCreateModel();
    }

    private void ShowMessage(string text, string type)
    {
        message = text;
        messageType = type;
    }

    private void ClearMessage()
    {
        message = string.Empty;
    }
}